  "require": {
    "php": "^8.3",
    "ext-dom": "*",
    "ext-pcre": "*",
    "ext-pgsql": "*",
    "ext-simplexml": "*",
    "ext-spl": "*",
    "monolog/monolog": "^3.12",
    "kevinlebrun/colors.php": "^1.0"
  },
  "require-dev": {
    "ext-pdo_mysql": "*",
    "phpunit/phpunit": "^12.0"
  },
  "suggest": {
    "ext-pdo": "Necessary to extract a schema from a MySQL database"
  },
  "bin": ["bin/dbsteward"],
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
